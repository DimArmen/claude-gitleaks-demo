#!/usr/bin/env bash
# Run a command, scan its output with gitleaks, and withhold the output from
# the model context if any secrets are found. Redaction at the tool boundary.
set -uo pipefail
GITLEAKS="${GITLEAKS_BIN:-gitleaks}"
CONFIG="${SECRET_GUARD_CONFIG:-}"
cfg=(); [ -n "$CONFIG" ] && cfg=(-c "$CONFIG")
[ "$#" -eq 0 ] && { echo "usage: secret-guard <command> [args...]" >&2; exit 64; }
output="$("$@" 2>&1)"; cmd_status=$?
if [ "${SECRET_GUARD_ALLOW:-0}" = "1" ]; then
  echo "⚠️  secret-guard: scan BYPASSED via SECRET_GUARD_ALLOW=1 (logged)" >&2
  printf '%s\n' "$output"; exit "$cmd_status"
fi
findings="$(printf '%s' "$output" | "$GITLEAKS" detect --pipe "${cfg[@]}" --no-banner -v --redact 2>/dev/null)"
scan_status=$?
if [ "$scan_status" -eq 0 ]; then
  printf '%s\n' "$output"; exit "$cmd_status"
fi
summary="$(printf '%s\n' "$findings" | awk '
  /^Finding:/ { sub(/^Finding:[ \t]*/,""); v=$0 }
  /^RuleID:/  { sub(/^RuleID:[ \t]*/,"");  r=$0 }
  /^Entropy:/ { if (r != "") printf "    %-32s  %s\n", r, v; r=""; v="" }
')"
n=$(printf '%s\n' "$findings" | grep -c '^RuleID:')
echo "⛔ secret-guard blocked output of: $*"
echo "   gitleaks flagged ${n} secret(s). Raw output WITHHELD from model context."
echo "   ─────────────────────────────────────────────────────────────"
printf '%s\n' "$summary"
echo "   ─────────────────────────────────────────────────────────────"
echo "   override (audited):  SECRET_GUARD_ALLOW=1 secret-guard $*"
exit 2
